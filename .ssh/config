Include ~/.ssh/config-personal
Include ~/.ssh/config-work

Host 127.0.0.1 localhost ::1
     AddKeysToAgent no

Host *
     ForwardAgent yes
     TCPKeepAlive yes
     IdentityFile ~/.ssh/id_ed25519
     CanonicalizeHostname yes
     CanonicalDomains kgarner.com
     AddKeysToAgent yes
     ControlMaster auto
     ControlPath ~/.ssh/controls/%r@%h:%p
